{
  "$schema": "https://aka.ms/terminal-profiles-schema",
  "copyOnSelect": false,
  "showTerminalTitleInTitlebar": true,
  "profiles": {
    "defaults": {
      "font": {
        "face": "JetBrainsMono Nerd Font"
      },
      "colorScheme": "Teide Darker"
    }
  },
  "actions": [
    {
      "command": {
        "action": "moveFocus",
        "direction": "left"
      },
      "keys": "alt+h"
    },
    {
      "command": {
        "action": "resizePane",
        "direction": "left"
      },
      "keys": "alt+shift+h"
    },
    {
      "command": {
        "action": "moveFocus",
        "direction": "down"
      },
      "keys": "alt+j"
    },
    {
      "command": {
        "action": "resizePane",
        "direction": "down"
      },
      "keys": "alt+shift+j"
    },
    {
      "command": {
        "action": "moveFocus",
        "direction": "up"
      },
      "keys": "alt+k"
    },
    {
      "command": {
        "action": "resizePane",
        "direction": "up"
      },
      "keys": "alt+shift+k"
    },
    {
      "command": {
        "action": "moveFocus",
        "direction": "right"
      },
      "keys": "alt+l"
    },
    {
      "command": {
        "action": "resizePane",
        "direction": "right"
      },
      "keys": "alt+shift+l"
    },
    {
      "command": {
        "action": "splitPane",
        "split": "vertical",
        "commandline": "pwsh.exe -NoLogo"
      },
      "keys": "alt+v"
    },
    {
      "command": {
        "action": "splitPane",
        "split": "horizontal",
        "commandline": "pwsh.exe -NoLogo"
      },
      "keys": "alt+s"
    },
    {
      "command": {
        "action": "togglePaneZoom"
      },
      "keys": "alt+z"
    },
    {
      "command": {
        "action": "newTab",
        "commandline": "pwsh.exe -NoLogo"
      },
      "keys": "alt+c"
    },
    {
      "command": {
        "action": "prevTab",
        "tabSwitcherMode": "disabled"
      },
      "keys": "alt+p"
    },
    {
      "command": {
        "action": "nextTab",
        "tabSwitcherMode": "disabled"
      },
      "keys": "alt+n"
    },
    {
      "command": {
        "action": "moveTab",
        "direction": "backward"
      },
      "keys": "alt+shift+p"
    },
    {
      "command": {
        "action": "moveTab",
        "direction": "forward"
      },
      "keys": "alt+shift+n"
    },
    {
      "command": {
        "action": "switchToTab",
        "index": 0
      },
      "keys": "alt+1"
    },
    {
      "command": {
        "action": "switchToTab",
        "index": 1
      },
      "keys": "alt+2"
    },
    {
      "command": {
        "action": "switchToTab",
        "index": 2
      },
      "keys": "alt+3"
    },
    {
      "command": {
        "action": "switchToTab",
        "index": 3
      },
      "keys": "alt+4"
    },
    {
      "command": {
        "action": "switchToTab",
        "index": 4
      },
      "keys": "alt+5"
    },
    {
      "command": {
        "action": "switchToTab",
        "index": 5
      },
      "keys": "alt+6"
    },
    {
      "command": {
        "action": "switchToTab",
        "index": 6
      },
      "keys": "alt+7"
    },
    {
      "command": {
        "action": "switchToTab",
        "index": 7
      },
      "keys": "alt+8"
    },
    {
      "command": {
        "action": "tabSearch"
      },
      "keys": "alt+/"
    },
    {
      "command": {
        "action": "newTab",
        "tabTitle": "Projects",
        "commandline": "pwsh.exe -NoLogo -NoExit -Command \"proj -PickerTab\""
      },
      "keys": "alt+f"
    },
    {
      "command": {
        "action": "newTab",
        "tabTitle": "Projects",
        "commandline": "pwsh.exe -NoLogo -NoExit -Command \"proj -PickerTab -Active\""
      },
      "keys": "alt+w"
    },
    {
      "command": {
        "action": "newTab",
        "tabTitle": "Projects",
        "commandline": "pwsh.exe -NoLogo -NoExit -Command \"proj -PickerTab -Last\""
      },
      "keys": "alt+backspace"
    },
    {
      "command": {
        "action": "commandPalette"
      },
      "keys": "ctrl+shift+p"
    }
  ],
  "schemes": [
    {
      "background": "#171B20",
      "black": "#12161a",
      "blue": "#5CCEFF",
      "brightBlack": "#414868",
      "brightBlue": "#5CCEFF",
      "brightCyan": "#0AE7FF",
      "brightGreen": "#38FFA5",
      "brightPurple": "#A592FF",
      "brightRed": "#F97791",
      "brightWhite": "#E7EAEE",
      "brightYellow": "#FFE77A",
      "cursorColor": "#E7EAEE",
      "cyan": "#0AE7FF",
      "foreground": "#E7EAEE",
      "green": "#38FFA5",
      "name": "Teide Darker",
      "purple": "#FFB3EC",
      "red": "#F97791",
      "selectionBackground": "#2f3546",
      "white": "#a9b1d6",
      "yellow": "#FFE77A"
    },
    {
      "name": "Doom One",
      "cursorColor": "#BBC2CF",
      "selectionBackground": "#2257A0",
      "background": "#282C34",
      "foreground": "#BBC2CF",
      "black": "#1B2229",
      "blue": "#51AFEF",
      "cyan": "#46D9FF",
      "green": "#98BE65",
      "purple": "#C678DD",
      "red": "#FF6C6B",
      "white": "#9CA0A4",
      "yellow": "#ECBE7B",
      "brightBlack": "#3F444A",
      "brightBlue": "#2257A0",
      "brightCyan": "#5699AF",
      "brightGreen": "#4DB5BD",
      "brightPurple": "#A9A1E1",
      "brightRed": "#DA8548",
      "brightWhite": "#DFDFDF",
      "brightYellow": "#ECBE7B"
    }
  ]
}
